# ── API keys ────────────────────────────────────────────────
OPENROUTER_API_KEY=
TAVILY_API_KEY=
E2B_API_KEY=

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://ba:ba@localhost:5432/ba_agent

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod
JWT_EXPIRE_MINUTES=1440

# ── Brain (OpenRouter model routing) ────────────────────────
# Strong reasoning: Stages 1, 4, 5, 6
MODEL_STRONG=anthropic/claude-sonnet-4
# Efficient breadth: Stages 2, 3
MODEL_EFFICIENT=openai/gpt-4o-mini

# ── HITL gate modes (G1, G6 are always BLOCK) ───────────────
GATE_MODE_S2=REVIEW_ABLE
GATE_MODE_S3=REVIEW_ABLE
GATE_MODE_S4=REVIEW_ABLE
GATE_MODE_S5=REVIEW_ABLE

# ── Harness ─────────────────────────────────────────────────
STAGE_RECURSION_LIMIT=120
STAGE_RETRIES=2
STAGE_TIMEOUT_SECONDS=1800
